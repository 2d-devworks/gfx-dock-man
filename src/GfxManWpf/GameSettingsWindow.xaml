<ui:FluentWindow x:Class="GfxManWpf.GameSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:GfxManWpf"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        mc:Ignorable="d"
        Icon="{x:Static Member=local:App.MainIconImageSource}"
        Height="300" Width="800"
        >
    <Window.Resources>
        <DataTemplate x:Key="MyListItemControlsTemplate">
            <StackPanel  VerticalAlignment="Center" Orientation="Horizontal">
                <Button DataContext="{Binding }" Name="ChangeSettingsFileButton" Width="Auto" Margin="2" Click="ChangeSettingsFile_OnClick">Change</Button>
                <Button DataContext="{Binding }" Name="DeleteSettingsFileButton" Width="Auto" Margin="2" Click="DeleteSettingsFile_OnClick">Delete</Button>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Game Settings" Icon="pack://application:,,,/GfxManWpf;component/Assets/2d-devworks.ico" ></ui:TitleBar>
        <Grid DockPanel.Dock="Top" DataContext="{Binding Model}" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:TextBlock VerticalAlignment="Center" Margin="2" FontWeight="Bold">Name:</ui:TextBlock>
                <ui:TextBox Name="NameTextBox" Margin="2" Width="250" Text="{Binding Name}"></ui:TextBox>
            </StackPanel>
            <ui:ListView ItemsSource="{Binding MySettingsFiles, RelativeSource={RelativeSource AncestorType={x:Type local:GameSettingsWindow }}}" Grid.Row="1">
                <ListView.View>
                    <ui:GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding}" Header="Settings File Path" Width="525"></GridViewColumn>
                        <GridViewColumn CellTemplate="{StaticResource MyListItemControlsTemplate}" Width="225"></GridViewColumn>
                    </ui:GridView>
                </ListView.View>
            </ui:ListView>
            <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:Button Margin="2" Width="Auto" Click="AddSettingsFileButton_OnClick">Add File</ui:Button>
                <ui:Button Margin="2" Width="Auto" Click="SaveGameSettingsButton_OnClick">Save Changes</ui:Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
