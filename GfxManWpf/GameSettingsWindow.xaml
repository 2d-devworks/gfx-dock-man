<Window x:Class="GfxManWpf.GameSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GfxManWpf"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        mc:Ignorable="d"
        Icon="handheld.ico"
        Title="Game Settings" Height="450" Width="800"
        >
    <Window.Resources>
        <DataTemplate x:Key="MyListItemControlsTemplate">
            <StackPanel  VerticalAlignment="Center" Orientation="Horizontal">
                <Button DataContext="{Binding }" Name="ChangeSettingsFileButton" Width="50" Height="20" Margin="2" Click="ChangeSettingsFile_OnClick">Change</Button>
                <Button DataContext="{Binding }" Name="DeleteSettingsFileButton" Width="50" Height="20" Margin="2" Click="DeleteSettingsFile_OnClick">Delete</Button>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid DataContext="{Binding Model}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Margin="2">Name:</TextBlock>
            <TextBox Margin="2" Width="250" Text="{Binding Name}"></TextBox>
        </StackPanel>
        <ListView ItemsSource="{Binding MySettingsFiles, RelativeSource={RelativeSource AncestorType={x:Type local:GameSettingsWindow }}}" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding}" Header="Settings File Path" Width="580"></GridViewColumn>
                    <GridViewColumn CellTemplate="{StaticResource MyListItemControlsTemplate}" Width="125"></GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Margin="2" Width="75" Height="25" Click="AddSettingsFileButton_OnClick">Add File</Button>
            <Button Margin="2" Width="100" Height="25" Click="SaveGameSettingsButton_OnClick">Save Changes</Button>
        </StackPanel>
    </Grid>
</Window>
